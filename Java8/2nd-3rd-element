import java.util.*;
import java.util.stream.Collectors;


class Main {
    public static void main(String[] args) {
        List<Integer> list = Arrays.asList(10, 20, 30, 40, 50);
        
        List<Integer> list2 = list.stream()
        .skip(1)
        .limit(2)
        .collect(Collectors.toList());
        
        System.out.println(list2);
    }
}
